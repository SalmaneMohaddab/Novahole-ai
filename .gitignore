# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Next.js build output
/.next/
/out/
/build

# caches
.turbo
.cache

# environment variables
.env
.env*.local
.env.development
.env.production
.env.test

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# system and editor files
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.swp
*.swo

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel deployment
.vercel
